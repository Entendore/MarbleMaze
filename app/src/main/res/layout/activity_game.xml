<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:importantForAccessibility="noHideDescendants">
    <FrameLayout android:id="@+id/game_container"
        android:layout_width="match_parent" android:layout_height="match_parent"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:orientation="horizontal"
        android:paddingBottom="16dp">
        <Button android:id="@+id/pause_button" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginEnd="8dp"
            android:minWidth="86dp" android:text="@string/pause"/>
        <Button android:id="@+id/rewind_button" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginEnd="8dp"
            android:minWidth="86dp" android:text="@string/rewind"/>
        <Button android:id="@+id/restart_button" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginEnd="8dp"
            android:minWidth="86dp" android:text="@string/restart"/>
        <Button android:id="@+id/menu_button" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minWidth="86dp" android:text="@string/menu"/>
    </LinearLayout>
</FrameLayout>
